# microservice specific routes

->          /hmrc-frontend                               hmrcfrontend.Routes

GET         /                                            controllers.IndexController.onPageLoad()

GET         /assets/*file                                controllers.Assets.versioned(path="/public", file: Asset)

GET        /searchPage                        controllers.SearchPageController.onPageLoad(mode: Mode = NormalMode)
POST       /searchPage                        controllers.SearchPageController.onSubmit(mode: Mode = NormalMode)
GET        /changeSearchPage                  controllers.SearchPageController.onPageLoad(mode: Mode = CheckMode)
POST       /changeSearchPage                  controllers.SearchPageController.onSubmit(mode: Mode = CheckMode)
