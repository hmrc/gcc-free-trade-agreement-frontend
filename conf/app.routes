# microservice specific routes

->          /hmrc-frontend                    hmrcfrontend.Routes

GET         /                                 controllers.IndexController.onPageLoad()

GET         /assets/*file                     controllers.Assets.versioned(path="/public", file: Asset)

GET        /search-pod-number                       controllers.SearchController.onPageLoad()
POST       /search-pod-number                       controllers.SearchController.onSubmit()

GET        /ftaRegistration                       controllers.FtaRegistrationController.onPageLoad(podReference: Option[String] ?= None)
